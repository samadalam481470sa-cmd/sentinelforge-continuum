# Legacy demo/API-key route. Use a generated secret; do not commit real values.
SENTINELFORGE_API_KEY=replace-with-a-random-secret-at-least-24-characters

# OIDC-secured enterprise routes.
# SENTINELFORGE_OIDC_ISSUER=https://id.example.com/
# SENTINELFORGE_OIDC_AUDIENCE=sentinelforge-api
# SENTINELFORGE_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
# Tokens must contain trusted tenant_id and roles claims (viewer, analyst, admin).

# Local development persistence only.
SENTINELFORGE_DB_PATH=/tmp/sentinelforge.db

# Hardening / monitoring.
SENTINELFORGE_MAX_BODY_BYTES=1048576
SENTINELFORGE_RATE_LIMIT_PER_MINUTE=120
# SENTINELFORGE_METRICS_TOKEN=replace-with-a-separate-random-secret
